{
  "name": "electron-starter",
  "version": "0.0.0",
  "description": "A minimal Electron application",
  "main": "dist-electron/main.js",
  "type": "module",
  "repository": "https://github.com/ygqygq2/ai-wallpaper",
  "keywords": [
    "vite",
    "react",
    "electron",
    "tailwindcss",
    "typescript"
  ],
  "author": "ygqygq2",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "app:dir": "vite build && electron-builder --dir",
    "app:dist": "vite build && electron-builder",
    "lint": "eslint src electron",
    "lint-fix": "eslint --fix src electron",
    "clean": "rimraf dist dist-electron release",
    "type-check": "tsc --noEmit",
    "postinstall": "simple-git-hooks",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@ygqygq2/eslint-config": "^1.1.0",
    "@ygqygq2/stylelint-config": "^0.0.4",
    "@ygqygq2/typescript-config": "^0.0.6",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "simple-git-hooks": "^2.13.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "electron-builder-squirrel-windows": "*",
        "dmg-builder": "*"
      }
    }
  },
  "simple-git-hooks": {
    "pre-commit": "lint-staged",
    "preserveUnused": true
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": "pnpm run lint",
    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "prettier --write"
    ]
  }
}
